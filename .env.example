# Copy to .env and fill in what you need. kiro-heal loads .env from the repo root.

# ── Kane CLI (optional peer — offline fixture simulator is the default)
# npm i -D @testmuai/kane-cli && kane-cli login
# KANE_CLI_BIN=kane-cli
# KIRO_HEAL_SIMULATE_KANE=1
# KIRO_HEAL_FIXTURE=.kiro-heal/fixture.json

# ── Local pipeline
# KIRO_HEAL_BASE_URL=http://localhost:3000
# KIRO_HEAL_TEST=.kiro-heal/smoke.testmd
# KIRO_HEAL_TARGET=demo/public/js/main.js
# KIRO_HEAL_MAX=5
# KIRO_HEAL_TIMEOUT=180
# KIRO_HEAL_DEBOUNCE=1200
# KIRO_HEAL_PROVIDER=auto          # local | auto | api
# KIRO_HEAL_DEMO_BROKEN=0          # 1 injects the demo CTA regression on init
# KIRO_HEAL_VERBOSE=1
# KIRO_HEAL_DRY_RUN=1

# ── LLM healer (only needed when local rules cannot fix a failure)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# KIRO_HEAL_MODEL=gpt-4o-mini
# KIRO_HEAL_API_URL=               # OpenAI-compatible chat/completions URL
# KIRO_HEAL_API_KEY=

# ── Automated PRs (off by default — set to 1 to allow the bot to open PRs)
# KIRO_HEAL_OPEN_PR=0
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=

# ── GitHub App webhook server
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# KIRO_HEAL_GITHUB_PORT=3939
# KIRO_HEAL_GITHUB_AUTO_PUSH=0
# KIRO_HEAL_GITHUB_EVENT=kiro-heal-verify
# KIRO_HEAL_WORK_DIR=/tmp/kiro-heal

# ── Optional: import() changed JS files during watch (can execute user code)
# KIRO_HEAL_RUNTIME_CHECK=0

