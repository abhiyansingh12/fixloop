# Copy to .env. fixloop loads .env from the repo root.
# Canonical prefix is FIXLOOP_*. KIRO_HEAL_* is still read for one release.

# ── Playwright (default oracle)
# FIXLOOP_ORACLE=playwright
# FIXLOOP_PLAYWRIGHT_COMMAND=npx playwright test
# FIXLOOP_PLAYWRIGHT_REPORT=test-results/fixloop.json

# ── Kane adapter (optional — not required to try fixloop)
# npm i -D @testmuai/kane-cli && kane-cli login
# FIXLOOP_ORACLE=kane
# KANE_CLI_BIN=kane-cli

# ── Fixture fallback (no Playwright / Kane)
# FIXLOOP_ORACLE=fixture
# FIXLOOP_FIXTURE=.fixloop/fixture.json
# FIXLOOP_SIMULATE=1

# ── Local pipeline
# FIXLOOP_BASE_URL=http://localhost:5173
# FIXLOOP_TEST=.fixloop/smoke.testmd
# FIXLOOP_TARGET=src/main.js
# FIXLOOP_MAX=3
# FIXLOOP_TIMEOUT=180
# FIXLOOP_DEBOUNCE=1200
# FIXLOOP_PROVIDER=auto          # local | auto | api
# FIXLOOP_DEMO_BROKEN=0
# FIXLOOP_DRY_RUN=1

# ── LLM healer (only when local rules cannot fix a product_regression)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# FIXLOOP_MODEL=gpt-4o-mini
# FIXLOOP_API_URL=
# FIXLOOP_API_KEY=

# ── Automated PRs
# Local CLI: off unless FIXLOOP_OPEN_PR=1
# GitHub Action: draft PR after a green re-run; set 0 to disable
# FIXLOOP_OPEN_PR=0
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=

# ── Optional GitHub App webhook server (secondary to the Action)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# FIXLOOP_GITHUB_PORT=3939
# FIXLOOP_GITHUB_AUTO_PUSH=0
# FIXLOOP_GITHUB_EVENT=fixloop-verify
# FIXLOOP_WORK_DIR=/tmp/fixloop

# ── Optional: import() changed JS files during watch (can execute user code)
# FIXLOOP_RUNTIME_CHECK=0
